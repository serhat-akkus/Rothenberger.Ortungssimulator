<Window x:Class="Rothenberger.Ortungssimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Rothenberger.Ortungssimulator.ViewModels"
        Title="Ortungssimulator" Height="1200" Width="1400">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Canvas für die Simulation -->
        <Canvas Name="SimCanvas"
                Width="1000" Height="1000"
                Background="LightGray"
                MouseMove="SimCanvas_MouseMove"
                MouseLeftButtonDown="SimCanvas_MouseLeftButtonDown"
                Margin="20">
            <!-- X-förmige Sonde -->
            <Canvas x:Name="Probe"
                    Visibility="{Binding ProbeVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                    Canvas.Left="{Binding ProbeX}"
                    Canvas.Top="{Binding ProbeY}">
                <Line X1="-20" Y1="-20" X2="20" Y2="20" Stroke="Red" StrokeThickness="5"/>
                <Line X1="20" Y1="-20" X2="-20" Y2="20" Stroke="Red" StrokeThickness="5"/>
            </Canvas>
            <!-- Klickpunkt anzeigen -->
            <Ellipse Width="10" Height="10"
                     Fill="Blue"
                     Visibility="{Binding ShowScale, Converter={StaticResource BoolToVisibilityConverter}}"
                     Canvas.Left="{Binding ClickedX, Converter={StaticResource CenterEllipseConverter}, ConverterParameter=10}"
                     Canvas.Top="{Binding ClickedY, Converter={StaticResource CenterEllipseConverter}, ConverterParameter=10}"/>
        </Canvas>
        <!-- Rechte Spalte: Timer und Skala -->
        <StackPanel Grid.Column="1" Margin="40,20,20,20" VerticalAlignment="Top">
            <TextBlock FontSize="24" FontWeight="Bold" Text="Ortungssimulator"/>
            <TextBlock FontSize="18" Margin="0,20,0,0"
                       Text="{Binding Elapsed, StringFormat='Timer: {0:mm\\:ss\\.ff}'}"
                       Visibility="{Binding TimerRunning, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <TextBlock FontSize="18" Margin="0,20,0,0"
                       Text="{Binding DistanceToProbeMeter, StringFormat='Distanz zur Sonde: {0:F2} m'}"
                       Visibility="{Binding ShowScale, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <ComboBox ItemsSource="{Binding ToneTypes}"
                      SelectedItem="{Binding SelectedToneType, Mode=TwoWay}"
                      Margin="0,20,0,0"
                      FontSize="16"/>
        </StackPanel>
    </Grid>
</Window>
