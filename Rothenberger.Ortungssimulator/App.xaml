<Application x:Class="Rothenberger.Ortungssimulator.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Rothenberger.Ortungssimulator.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:CenterEllipseConverter x:Key="CenterEllipseConverter"/>
        <conv:SinusVisibilityConverter x:Key="SinusVisibilityConverter"/>
        <conv:ShepardVisibilityConverter x:Key="ShepardVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:ToneTypeParameterVisibilityConverter x:Key="ToneTypeParameterVisibilityConverter"/>
    </Application.Resources>
</Application>
