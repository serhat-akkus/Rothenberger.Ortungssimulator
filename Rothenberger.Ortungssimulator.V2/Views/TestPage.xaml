<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Rothenberger.Ortungssimulator.V2.Views.TestPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Rothenberger.Ortungssimulator.V2.ViewModels"
    xmlns:views="clr-namespace:Rothenberger.Ortungssimulator.V2.Views"
    BackgroundColor="White"
    Padding="10">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="1000,Auto">
        <!-- Oberer Bereich: Tiefe + Radius darüber, darunter Timer + Distanz -->
        <StackLayout Grid.Row="0" Grid.Column="0" HorizontalOptions="Center" Margin="0,20,0,0" Spacing="6">
            <StackLayout Orientation="Horizontal" Spacing="24" HorizontalOptions="Center">
                <Label Text="{Binding ProbeDepthMeters, StringFormat='Sondentiefe: {0:F1} m'}" FontSize="18" />
                <Label Text="{Binding EffectiveProbeRadiusMeters, StringFormat='Sondenradius: {0:F1} m'}" FontSize="18" />
            </StackLayout>
            <StackLayout Orientation="Horizontal" Spacing="8" HorizontalOptions="Center">
                <Label Text="Timer:" FontSize="24" />
                <Label Text="{Binding TimerText}" FontSize="24" />
                <Label Text="{Binding DistanceText}" FontSize="24" Margin="20,0,0,0" />
            </StackLayout>
        </StackLayout>

        <!-- Canvas und Button darunter -->
        <AbsoluteLayout Grid.Row="1" Grid.Column="0" HeightRequest="1000" WidthRequest="1000">
            <GraphicsView
                x:Name="CanvasView"
                HeightRequest="1000"
                WidthRequest="1000"
                AbsoluteLayout.LayoutBounds="0,0,1000,1000"
                AbsoluteLayout.LayoutFlags="None"
                PointerMoved="CanvasView_PointerMoved"
                InputTransparent="{Binding IsRunNotStarted}" />

            <Border
                x:Name="ArrowBorder"
                HeightRequest="120"
                WidthRequest="120"
                IsVisible="{Binding IsArrowBoxVisible}"
                InputTransparent="True"
                AbsoluteLayout.LayoutBounds="880,0,120,120"
                AbsoluteLayout.LayoutFlags="None">
                <GraphicsView
                    x:Name="ArrowView"
                    HeightRequest="120"
                    WidthRequest="120"
                    InputTransparent="True" />
            </Border>

            <Button
                Text="{Binding StartRunButtonText}"
                IsVisible="{Binding IsRunNotStarted}"
                Command="{Binding StartRunCommand}"
                WidthRequest="200"
                HeightRequest="60"
                BackgroundColor="White"
                TextColor="Black"
                Opacity="0.95"
                InputTransparent="False"
                AbsoluteLayout.LayoutBounds="400,470,200,60"
                AbsoluteLayout.LayoutFlags="None" />
        </AbsoluteLayout>

        <!-- Ergebnisliste -->
        <CollectionView
            Grid.Row="1"
            Grid.Column="1"
            ItemsSource="{Binding RunResults}" VerticalOptions="FillAndExpand">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal">
                        <Label Text="{Binding Name}" />
                        <Label Text="{Binding ToneType}" Margin="10,0,0,0" />
                        <Label Text="{Binding Timestamp}" Margin="10,0,0,0" />
                        <Label Text="{Binding Time}" Margin="10,0,0,0" />
                        <Label Text="{Binding Distance}" Margin="10,0,0,0" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <views:RunsCompletedDialog Grid.RowSpan="2" Grid.ColumnSpan="2" ZIndex="100" />
    </Grid>
</ContentPage>