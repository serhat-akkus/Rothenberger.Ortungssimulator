<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
               xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
               xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
               x:Class="Rothenberger.Ortungssimulator.V2.Views.SaveResultsPopup"
               WidthRequest="400"
               HeightRequest="250">
    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Datei gespeichert"
               FontAttributes="Bold"
               FontSize="18" />
        <Label x:Name="PathLabel"
               LineBreakMode="WordWrap"
               FontSize="14" />
        <Label Text="Pfad in Zwischenablage kopieren?"
               FontSize="14" />
        <HorizontalStackLayout Spacing="10">
            <Button Text="Kopieren" x:Name="CopyButton" />
            <Button Text="Weiter" x:Name="ContinueButton" />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</toolkit:Popup>